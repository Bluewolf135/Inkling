{
	"name": "inkling",
	"version": "0.1.0",
	"description": "Handwritten and text-based annotation for Markdown notes and PDFs in Obsidian, built mobile-first for stylus input.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
